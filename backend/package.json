{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test mocha --require test/setup.js \"test/unit/**/*.spec.js\" --timeout 10000",
    "test:watch": "npm run test -- --watch",
    "coverage": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pino": "^8.21.0",
    "pino-http": "^8.6.0"
  },
  "nyc": {
  "all": true,
  "extension": [".js"],
  "include": ["src/**/*.js"],
  "exclude": [
    "src/server.js",
    "src/middleware/**",
    "src/config/**",
    "test/**"
  ],
  "reporter": ["text", "lcov", "html"],
  "report-dir": "./coverage",
  "instrument": true,
  "sourceMap": false
},
  "devDependencies": {
    "chai": "^4.3.10",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.4",
    "nodemon": "^3.1.10",
    "nyc": "^17.1.0",
    "pino-pretty": "^13.1.1",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4"
  }
}